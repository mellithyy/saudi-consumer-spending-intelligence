              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What it leaves out",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "10pt",
                      "color": "#13161B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cash and online shopping. Growth mixes real spending, prices and the move from cash to cards.",
