model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_city","dim_sector","fact_national","fact_city","fact_sector","Measures_"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_city
ref table dim_sector
ref table fact_national
ref table fact_city
ref table fact_sector
ref table Measures_
ref table 'Sort sector'
ref table 'Sort city'

ref cultureInfo en-US

