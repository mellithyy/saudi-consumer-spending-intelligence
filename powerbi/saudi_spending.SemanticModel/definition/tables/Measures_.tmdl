			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
