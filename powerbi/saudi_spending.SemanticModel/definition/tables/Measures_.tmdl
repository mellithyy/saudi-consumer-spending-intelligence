table Measures_
	lineageTag: 1be87336-25ac-403e-b7aa-ae5e46aa3ed5

	/// Card spending, billion SAR: the country, or the city or sector picked on the Overview. Blank if both are picked.
	measure 'Spent bn SAR' =
			SWITCH (
			    TRUE (),
			    ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ), BLANK (),
			    ISFILTERED ( dim_city[city] ), [City bn SAR],
			    ISFILTERED ( dim_sector[sector] ), [Sector bn SAR],
			    [National bn SAR]
			)
		formatString: #,0.00
		displayFolder: 1 Base
		lineageTag: 5438f43d-836c-4e21-8251-7b63fd037ddb

	/// Number of card payments, millions. Same focus rule as Spent bn SAR.
	measure 'Payments m' =
			SWITCH (
			    TRUE (),
			    ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ), BLANK (),
			    ISFILTERED ( dim_city[city] ), DIVIDE ( SUM ( fact_city[transactions_k] ), 1000 ),
			    ISFILTERED ( dim_sector[sector] ), DIVIDE ( SUM ( fact_sector[transactions_k] ), 1000 ),
			    DIVIDE ( SUM ( fact_national[transactions_k] ), 1000 )
			)
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: 883439b2-4701-4e0e-9444-caa202c4b759

	/// Total spent divided by total payments (never an average of averages). Both columns are in thousands, so the thousands cancel.
	measure 'Average payment SAR' =
			SWITCH (
			    TRUE (),
			    ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ), BLANK (),
			    ISFILTERED ( dim_city[city] ), DIVIDE ( SUM ( fact_city[value_k_sar] ), SUM ( fact_city[transactions_k] ) ),
			    ISFILTERED ( dim_sector[sector] ), DIVIDE ( SUM ( fact_sector[value_k_sar] ), SUM ( fact_sector[transactions_k] ) ),
			    DIVIDE ( SUM ( fact_national[value_k_sar] ), SUM ( fact_national[transactions_k] ) )
			)
		formatString: #,0.0
		displayFolder: 1 Base
		lineageTag: 9b261f78-6dfa-488b-ad87-e813fb7ffb1a

	/// Weeks in view: dim_date has one row per week.
	measure 'Weeks' =
			COUNTROWS ( dim_date )
		formatString: 0
		displayFolder: 1 Base
		lineageTag: b11049be-5972-56d5-8792-e6f3b229b361

	/// Spending in an average week in view, billion SAR.
	measure 'Average week bn SAR' =
			DIVIDE ( [Spent bn SAR], [Weeks] )
		formatString: #,0.00
		displayFolder: 1 Base
		lineageTag: 94ace2cd-f094-5228-83a4-eb7170a0f3d4

	/// This year's spending on the week numbers the year before also has.
	measure 'Spent same weeks bn' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE ( [Spent bn SAR], KEEPFILTERS ( weeks_year_before ) )
		formatString: #,0.00
		displayFolder: 2 Same weeks a year before
		lineageTag: 307b6618-6204-501e-83aa-f1d6e4cc44ae

	/// The year before's spending on the same week numbers as the weeks in view.
	measure 'Spent year before bn' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_now = VALUES ( dim_date[week_of_year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE (
			        [Spent bn SAR],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1,
			        INTERSECT ( weeks_now, weeks_year_before )
			    )
		formatString: #,0.00
		displayFolder: 2 Same weeks a year before
		lineageTag: 958ffa12-8e06-5c82-aec8-2e563e099f10

	/// Spending growth on the same weeks a year before.
	measure 'Spending growth %' =
			VAR this_year_value = [Spent same weeks bn]
			VAR year_before_value = [Spent year before bn]
			RETURN
			    DIVIDE ( this_year_value - year_before_value, year_before_value )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 2 Same weeks a year before
		lineageTag: 95f31b86-8b3b-5cb7-ad94-ecaeefd06b1c

	measure 'Payments same weeks m' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE ( [Payments m], KEEPFILTERS ( weeks_year_before ) )
		formatString: #,0.0
		displayFolder: 2 Same weeks a year before
		lineageTag: 44e97459-2fad-5c12-9cab-07ac540ead33

	measure 'Payments year before m' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_now = VALUES ( dim_date[week_of_year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE (
			        [Payments m],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1,
			        INTERSECT ( weeks_now, weeks_year_before )
			    )
		formatString: #,0.0
		displayFolder: 2 Same weeks a year before
		lineageTag: 90af8a32-3e91-5a65-b56a-f7c757e3b9ac

	/// Growth in the number of payments on the same weeks a year before.
	measure 'Payments growth %' =
			VAR this_year_value = [Payments same weeks m]
			VAR year_before_value = [Payments year before m]
			RETURN
			    DIVIDE ( this_year_value - year_before_value, year_before_value )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 2 Same weeks a year before
		lineageTag: ba709fe4-29d5-5c05-97d1-723ff7308bc3

	measure 'Average payment same weeks SAR' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE ( [Average payment SAR], KEEPFILTERS ( weeks_year_before ) )
		formatString: #,0.0
		displayFolder: 2 Same weeks a year before
		lineageTag: f7d437bd-43bd-513d-8e76-ef667f812a54

	measure 'Average payment year before SAR' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_now = VALUES ( dim_date[week_of_year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE (
			        [Average payment SAR],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1,
			        INTERSECT ( weeks_now, weeks_year_before )
			    )
		formatString: #,0.0
		displayFolder: 2 Same weeks a year before
		lineageTag: 2d8a8b51-0a05-50e1-883d-3e95f51a2a3e

	/// Change in the average payment on the same weeks a year before.
	measure 'Average payment change %' =
			VAR this_year_value = [Average payment same weeks SAR]
			VAR year_before_value = [Average payment year before SAR]
			RETURN
			    DIVIDE ( this_year_value - year_before_value, year_before_value )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 2 Same weeks a year before
		lineageTag: f67ed6cd-4d91-51fd-a934-4b87dd6561dc

	/// The biggest week of the year before among the same week numbers (2025's weeks 1 to 27 meet 2024's weeks 1 to 27).
	measure 'Biggest week year before bn' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR weeks_now = VALUES ( dim_date[week_of_year] )
			VAR weeks_year_before =
			    CALCULATETABLE (
			        VALUES ( dim_date[week_of_year] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1
			    )
			RETURN
			    CALCULATE (
			        MAXX ( VALUES ( dim_date[week_start] ), [Spent bn SAR] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = this_year - 1,
			        INTERSECT ( weeks_now, weeks_year_before )
			    )
		formatString: #,0.00
		displayFolder: 2 Same weeks a year before
		lineageTag: 9bb50108-75c8-57b5-b236-c5e08bd9f166

	/// The year's biggest week against the biggest week of the same weeks a year before.
	measure 'Biggest week change %' =
			VAR this_year_value = [Biggest week bn]
			VAR year_before_value = [Biggest week year before bn]
			RETURN
			    DIVIDE ( this_year_value - year_before_value, year_before_value )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 2 Same weeks a year before
		lineageTag: bb442db6-a7d0-5d11-97fc-5a16736a23ec

	/// The biggest week in view, billion SAR.
	measure 'Biggest week bn' =
			MAXX ( VALUES ( dim_date[week_start] ), [Spent bn SAR] )
		formatString: #,0.00
		displayFolder: 3 Overview
		lineageTag: 5f4f4d57-ef5f-55c6-9fc8-d8232e33c0ca

	/// Shown only for the year's biggest week and the Eid al-Fitr week, so the weekly chart writes the value over just those two bars.
	measure 'Weekly chart label bn' =
			VAR this_week = [Spent bn SAR]
			-- every date filter but the year: the weekly chart (Deneb) groups its rows by week type and its hidden sort column,
			-- and with those filters left each week type had its own biggest week
			VAR biggest = CALCULATE ( [Biggest week bn], ALLEXCEPT ( dim_date, dim_date[year] ) )
			VAR is_eid_al_fitr = SELECTEDVALUE ( dim_date[eid] ) = "Eid al-Fitr"
			RETURN
			    IF ( this_week = biggest || is_eid_al_fitr, this_week )
		formatString: #,0.00
		displayFolder: 3 Overview
		lineageTag: bf909c12-a847-5724-a0a1-c0e5b56578ad

	/// The top of the weekly chart's value axis: 18% above its highest bar or dashed-line point, whatever the filters. Without this room, the label over the biggest week had no space above the bar and was drawn inside it. (25% in review round 1, while the legend shared the strip with 'Ramadan'; since round 5 the strip holds only 'Ramadan' and the layout check finds no label touching it from 15% up, for every year, city and sector.)
	measure 'Weekly axis max' =
			VAR highest =
			    MAXX ( VALUES ( dim_date[week_start] ), MAX ( [Spent bn SAR], [Spent year before bn] ) )
			RETURN
			    highest * 1.18
		formatString: #,0.00
		displayFolder: 3 Overview
		lineageTag: a4a01a5d-cbd0-5061-bb1f-8d6d4ab16ad2

	/// The month and year on the first week of each month ('Feb 2025'), empty on the other weeks: the weekly chart writes it under that week.
	measure 'Month label' =
			VAR week_start = SELECTEDVALUE ( dim_date[week_start] )
			RETURN
			    IF ( NOT ISBLANK ( week_start ) && DAY ( week_start ) <= 7, FORMAT ( week_start, "mmm yyyy" ) )
		displayFolder: 3 Overview
		lineageTag: 2e63bd8b-764b-571c-9ec8-ec3b9dfb230e

	/// The week from Sunday to Saturday as text ('23 to 29 Mar 2025'), for the weekly chart's tooltip.
	measure 'Week label' =
			VAR first_day = SELECTEDVALUE ( dim_date[week_start] )
			VAR last_day = first_day + 6
			RETURN
			    IF (
			        NOT ISBLANK ( first_day ),
			        FORMAT ( first_day, IF ( MONTH ( first_day ) = MONTH ( last_day ), "d", IF ( YEAR ( first_day ) = YEAR ( last_day ), "d mmm", "d mmm yyyy" ) ) )
			            & " to " & FORMAT ( last_day, "d mmm yyyy" )
			    )
		displayFolder: 3 Overview
		lineageTag: e8f9d7dc-817a-52cd-9af1-cb68e1dfd2ac

	/// The average normal week (no Ramadan day, no Eid) of 2021 to 2025 in this group of month days, against the average of the five groups. It ignores the Year filter on purpose: one year has too few normal weeks in each group.
	measure 'Payday index %' =
			VAR normal_week = [Payday average week bn]
			VAR five_groups = [Payday all groups bn]
			RETURN
			    IF ( NOT ISBLANK ( normal_week ), DIVIDE ( normal_week, five_groups ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 3 Overview
		lineageTag: c75270cb-1b1c-5f70-b1e8-f9028124414f

	/// The average normal week (no Ramadan day, no Eid) of 2021 to 2025 in this group of month days, billion SAR.
	measure 'Payday average week bn' =
			CALCULATE ( [Average week bn SAR], dim_date[week_type] = "Normal", dim_date[year] >= 2021 )
		formatString: #,0.00
		displayFolder: 3 Overview
		lineageTag: 2c092638-173f-5ca4-b967-91526079523b

	/// The average of the five groups' average normal weeks, billion SAR: what the payday index compares each group with.
	measure 'Payday all groups bn' =
			AVERAGEX (
			    ALL ( dim_date[month_days], dim_date[month_days_order] ),
			    CALCULATE ( [Average week bn SAR], dim_date[week_type] = "Normal", dim_date[year] >= 2021 )
			)
		formatString: #,0.00
		displayFolder: 3 Overview
		lineageTag: acf2811c-bd5a-56f7-adad-1710bf9fca78

	/// How many normal weeks of 2021 to 2025 start in this group of month days.
	measure 'Payday normal weeks' =
			CALCULATE ( [Weeks], dim_date[week_type] = "Normal", dim_date[year] >= 2021 )
		formatString: 0
		displayFolder: 3 Overview
		lineageTag: 6dc6b8fe-a962-5b53-a56c-bf7cd253c63c

	/// The whole country's spending growth, whatever city is in view.
	measure 'National growth %' =
			CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_city ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 4 Cities
		lineageTag: b0654138-4ede-5eaf-84b1-fed09c717bf6

	/// This city's part of the whole country's spending.
	measure 'Share of national %' =
			DIVIDE ( [Spent bn SAR], CALCULATE ( [Spent bn SAR], REMOVEFILTERS ( dim_city ) ) )
		formatString: 0.0%
		displayFolder: 4 Cities
		lineageTag: 1f332e70-c351-5d89-80f6-f12f7878c266

	/// The whole country's average payment, whatever city is in view.
	measure 'National average payment SAR' =
			CALCULATE ( [Average payment SAR], REMOVEFILTERS ( dim_city ) )
		formatString: #,0.0
		displayFolder: 4 Cities
		lineageTag: 91759e31-3e07-58aa-9d69-2dc214c45329

	/// Last year's growth for what is in view (the tick in the Cities bullet chart). Blank before 2022: the growth of 2021 compares with 2020, which starts in May, during the pandemic.
	measure 'Spending growth year before %' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    IF ( y - 1 >= 2022, CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_date ), dim_date[year] = y - 1 ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 4 Cities
		lineageTag: 974176c0-795b-598d-b14f-6c4a01e685f3

	/// What the Cities scorecard is sorted by, as the 'Sort by' buttons say: growth (default), share or average payment.
	measure 'City sort value' =
			VAR pick = SELECTEDVALUE ( 'Sort city'[Sort], "Growth" )
			RETURN
			    SWITCH ( pick, "Share", [Share of national %], "Avg. payment", [Average payment SAR], [Spending growth %] )
		formatString: 0.0000
		displayFolder: 4 Cities
		lineageTag: 81e16b62-2b70-5058-a3ba-13447aead89e

	/// What the Sectors table is sorted by, as the 'Sort by' buttons say: the change in the average payment (default), spent or spending growth.
	measure 'Sector sort value' =
			VAR pick = SELECTEDVALUE ( 'Sort sector'[Sort], "Avg. payment change" )
			RETURN
			    SWITCH ( pick, "Spent", [Spent bn SAR], "Spending growth", [Spending growth %], [Average payment change %] )
		formatString: 0.0000
		displayFolder: 5 Sectors
		lineageTag: 66bcc546-8bbd-5eae-8315-95bee10799c9

	/// This sector's part of all card spending (the sectors add up to the country).
	measure 'Share of spending %' =
			DIVIDE ( [Spent bn SAR], CALCULATE ( [Spent bn SAR], REMOVEFILTERS ( dim_sector ) ) )
		formatString: 0.0%
		displayFolder: 5 Sectors
		lineageTag: 19cb5592-5568-561f-a8a0-e970fc04779e

	/// The whole country's Ramadan lift, whatever city is in view.
	measure 'National Ramadan lift %' =
			CALCULATE ( [Ramadan last week lift %], REMOVEFILTERS ( dim_city ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: 00f18b84-7498-5192-a8ef-3fb6df02cdc6

	/// The last full week of Ramadan against the average of the 8 weeks before it, averaged over the Ramadans of 2021 to 2025.
	measure 'Ramadan last week lift %' =
			AVERAGEX (
			    FILTER ( ALL ( dim_date[ramadan_year] ), NOT ISBLANK ( dim_date[ramadan_year] ) ),
			    VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_phase] = "8 weeks before" )
			    VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_phase] = "Last full week" )
			    RETURN
			        IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
			)
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: d43e9eef-b84d-5fad-b0f2-487bb9a1b984

	/// The last full week of Ramadan 2021 against the average of the 8 weeks before it (one of the five years the lift averages).
	measure 'Ramadan 2021 lift %' =
			VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_year] = 2021, dim_date[ramadan_phase] = "8 weeks before" )
			VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_year] = 2021, dim_date[ramadan_phase] = "Last full week" )
			RETURN
			    IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: a799eec9-5018-5722-99f3-9bbe5fba41c4

	/// The last full week of Ramadan 2022 against the average of the 8 weeks before it (one of the five years the lift averages).
	measure 'Ramadan 2022 lift %' =
			VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_year] = 2022, dim_date[ramadan_phase] = "8 weeks before" )
			VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_year] = 2022, dim_date[ramadan_phase] = "Last full week" )
			RETURN
			    IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: 5ae4b310-a34c-5cda-910b-7626352d891c

	/// The last full week of Ramadan 2023 against the average of the 8 weeks before it (one of the five years the lift averages).
	measure 'Ramadan 2023 lift %' =
			VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_year] = 2023, dim_date[ramadan_phase] = "8 weeks before" )
			VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_year] = 2023, dim_date[ramadan_phase] = "Last full week" )
			RETURN
			    IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: 6a1cb574-7325-55f1-bad5-f34cb2d2f2f1

	/// The last full week of Ramadan 2024 against the average of the 8 weeks before it (one of the five years the lift averages).
	measure 'Ramadan 2024 lift %' =
			VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_year] = 2024, dim_date[ramadan_phase] = "8 weeks before" )
			VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_year] = 2024, dim_date[ramadan_phase] = "Last full week" )
			RETURN
			    IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: a818de61-f0cf-5b10-ab97-f51d172bfdca

	/// The last full week of Ramadan 2025 against the average of the 8 weeks before it (one of the five years the lift averages).
	measure 'Ramadan 2025 lift %' =
			VAR weeks_before = CALCULATE ( [Average week bn SAR], dim_date[ramadan_year] = 2025, dim_date[ramadan_phase] = "8 weeks before" )
			VAR last_full_week = CALCULATE ( [Spent bn SAR], dim_date[ramadan_year] = 2025, dim_date[ramadan_phase] = "Last full week" )
			RETURN
			    IF ( NOT ISBLANK ( last_full_week ), DIVIDE ( last_full_week, weeks_before ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: 6 Ramadan
		lineageTag: 2370ccbf-a5aa-5208-98d6-6e4d9985b184

	/// The cities or sectors the Overview is set to, always by name: up to five names ('Dammam, Khobar and Riyadh'), or, when most are picked, the ones left out ('all cities except Jeddah and Riyadh'). With 11 cities one of the two lists always has five names or fewer. Empty for the whole country.
	measure 'Focus name' =
			VAR cities_picked = VALUES ( dim_city[city] )
			VAR cities_left = EXCEPT ( ALL ( dim_city[city] ), cities_picked )
			VAR sectors_picked = VALUES ( dim_sector[sector] )
			VAR sectors_left = EXCEPT ( ALL ( dim_sector[sector] ), sectors_picked )
			VAR picked_city_last = CONCATENATEX ( TOPN ( 1, cities_picked, dim_city[city], DESC ), dim_city[city] )
			VAR picked_city_list =
			    CONCATENATEX ( FILTER ( cities_picked, dim_city[city] <> picked_city_last ), dim_city[city], ", ", dim_city[city], ASC )
			        & IF ( COUNTROWS ( cities_picked ) > 1, " and " ) & picked_city_last
			VAR left_city_last = CONCATENATEX ( TOPN ( 1, cities_left, dim_city[city], DESC ), dim_city[city] )
			VAR left_city_list =
			    CONCATENATEX ( FILTER ( cities_left, dim_city[city] <> left_city_last ), dim_city[city], ", ", dim_city[city], ASC )
			        & IF ( COUNTROWS ( cities_left ) > 1, " and " ) & left_city_last
			VAR picked_sector_last = CONCATENATEX ( TOPN ( 1, sectors_picked, dim_sector[sector], DESC ), dim_sector[sector] )
			VAR picked_sector_list =
			    CONCATENATEX ( FILTER ( sectors_picked, dim_sector[sector] <> picked_sector_last ), dim_sector[sector], ", ", dim_sector[sector], ASC )
			        & IF ( COUNTROWS ( sectors_picked ) > 1, " and " ) & picked_sector_last
			VAR left_sector_last = CONCATENATEX ( TOPN ( 1, sectors_left, dim_sector[sector], DESC ), dim_sector[sector] )
			VAR left_sector_list =
			    CONCATENATEX ( FILTER ( sectors_left, dim_sector[sector] <> left_sector_last ), dim_sector[sector], ", ", dim_sector[sector], ASC )
			        & IF ( COUNTROWS ( sectors_left ) > 1, " and " ) & left_sector_last
			VAR city_text =
			    SWITCH (
			        TRUE (),
			        COUNTROWS ( cities_left ) = 0, "all " & COUNTROWS ( cities_picked ) & " cities",
			        COUNTROWS ( cities_left ) < COUNTROWS ( cities_picked ), "all cities except " & left_city_list,
			        picked_city_list
			    )
			VAR sector_text =
			    SWITCH (
			        TRUE (),
			        COUNTROWS ( sectors_left ) = 0, "all " & COUNTROWS ( sectors_picked ) & " sectors",
			        COUNTROWS ( sectors_left ) < COUNTROWS ( sectors_picked ), "all sectors except " & left_sector_list,
			        picked_sector_list
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ), "",
			        ISFILTERED ( dim_city[city] ), city_text,
			        ISFILTERED ( dim_sector[sector] ), sector_text,
			        ""
			    )
		displayFolder: 7 Text
		lineageTag: 317ba4a8-d6a3-5143-99e8-3d0238067f66

	/// The Overview's title: this year's growth against last year's.
	measure 'Title Overview' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR both_picked = ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] )
			VAR names = [Focus name]
			-- the title line holds about 100 characters (the longest title with 36 characters of names is 99): longer lists show the count here, and the weekly chart subtitle names them
			VAR place =
			    IF (
			        LEN ( names ) <= 36,
			        names,
			        IF (
			            ISFILTERED ( dim_city[city] ),
			            COUNTROWS ( VALUES ( dim_city[city] ) ) & " cities",
			            COUNTROWS ( VALUES ( dim_sector[sector] ) ) & " sectors"
			        )
			    )
			VAR what =
			    SWITCH (
			        TRUE (),
			        ISFILTERED ( dim_city[city] ), "spending in " & place,
			        ISFILTERED ( dim_sector[sector] ), "spending on " & LOWER ( place ),
			        "spending"
			    )
			VAR growth = [Spending growth %]
			VAR growth_year_before = CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_date ), dim_date[year] = y - 1 )
			-- The comparison with the year before, worded for each case: two rises ("slower than 2024's 8.8%"),
			-- two falls ("a bigger fall than 2024's 33.0%"), or a turn ("after falling 3.1% in 2024").
			VAR before_text = FORMAT ( ABS ( growth_year_before ), "0.0%" )
			VAR comparison =
			    IF (
			        y - 1 >= 2022 && NOT ISBLANK ( growth_year_before ),
			        ", "
			            & SWITCH (
			                TRUE (),
			                growth >= 0 && growth_year_before >= 0,
			                    IF ( growth < growth_year_before, "slower than", IF ( growth > growth_year_before, "faster than", "the same as" ) )
			                        & " " & ( y - 1 ) & "'s " & before_text,
			                growth < 0 && growth_year_before < 0,
			                    IF ( growth < growth_year_before, "a bigger fall than", IF ( growth > growth_year_before, "a smaller fall than", "the same fall as" ) )
			                        & " " & ( y - 1 ) & "'s " & before_text,
			                growth < 0, "after growing " & before_text & " in " & ( y - 1 ),
			                "after falling " & before_text & " in " & ( y - 1 )
			            )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        both_picked, "Pick cities or sectors, not both: the source has no sector numbers inside a city",
			        ISBLANK ( y ), "Pick a year",
			        "In " & y & ", " & what & IF ( growth >= 0, " grew ", " fell " ) & FORMAT ( ABS ( growth ), "0.0%" ) & comparison
			    )
		displayFolder: 7 Text
		lineageTag: d0fd1c92-80a2-57a6-9ecd-a9d5eea0b718

	/// Under the weekly chart's title: the place and the year in view.
	measure 'Subtitle weekly chart' =
			VAR names = [Focus name]
			-- a capital first letter: 'all cities except Riyadh' starts the line here
			VAR place = UPPER ( LEFT ( names, 1 ) ) & MID ( names, 2, LEN ( names ) )
			RETURN
			    IF (
			        ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ),
			        "Pick cities or sectors, not both",
			        IF ( names <> "", place & ", " )
			            & IF ( HASONEVALUE ( dim_date[year] ), SELECTEDVALUE ( dim_date[year] ) & ", ", "all years, " ) & "bn SAR"
			    )
		displayFolder: 7 Text
		lineageTag: 6f0092bd-1219-5ee5-8afb-6f19ef40dfa5

	/// Under the 'Growth year by year' title: what the columns compare.
	measure 'Subtitle growth chart' =
			IF (
			    ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ),
			    "Pick cities or sectors, not both",
			    "On the same weeks a year before"
			)
		displayFolder: 7 Text
		lineageTag: 07c8604f-d1e8-5294-b843-91ca91e01afd

	/// Under the 'Spending by week of the month' title: which weeks, against what.
	measure 'Subtitle payday chart' =
			IF (
			    ISFILTERED ( dim_city[city] ) && ISFILTERED ( dim_sector[sector] ),
			    "Pick cities or sectors, not both",
			    "Normal weeks of 2021 to 2025, against the average week. Salaries are paid around the 27th."
			)
		displayFolder: 7 Text
		lineageTag: c27a97a3-e455-57fc-86ee-25ec1e1a7121

	/// Under the Spent card: how many weeks, from when to when.
	measure 'Note spent' =
			VAR first_day = MIN ( dim_date[week_start] )
			VAR last_day = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF (
			        NOT ISBLANK ( [Spent bn SAR] ),
			        [Weeks] & IF ( [Weeks] = 1, " week, ", " weeks, " )
			            & FORMAT ( first_day, "d mmm" )
			            & IF ( YEAR ( first_day ) <> YEAR ( last_day ), " " & YEAR ( first_day ) )
			            & " to " & FORMAT ( last_day, "d mmm yyyy" )
			    )
		displayFolder: 7 Text
		lineageTag: 80f19fb5-0128-518b-84fb-7b4af071dfea

	/// Under the biggest week card: its date and what kind of week it was.
	measure 'Note biggest week' =
			VAR biggest = [Biggest week bn]
			VAR biggest_week = MAXX ( FILTER ( VALUES ( dim_date[week_start] ), [Spent bn SAR] = biggest ), dim_date[week_start] )
			VAR phase = CALCULATE ( SELECTEDVALUE ( dim_date[phase] ), dim_date[week_start] = biggest_week )
			RETURN
			    -- with no biggest week (a city and a sector both picked), every blank week equals the blank maximum: no note then
			    IF (
			        NOT ISBLANK ( biggest ) && NOT ISBLANK ( biggest_week ),
			        FORMAT ( biggest_week, "d mmm" ) & IF ( NOT ISBLANK ( phase ), ", " & phase )
			    )
		displayFolder: 7 Text
		lineageTag: 05402bde-bce2-5c10-ad96-9c4539b91139

	/// The Cities page's title: how many cities grew faster than the country.
	measure 'Title Cities' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR national = CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_city ) )
			VAR every_city = ADDCOLUMNS ( ALL ( dim_city[city] ), "@growth", [Spending growth %] )
			VAR faster = COUNTROWS ( FILTER ( every_city, [@growth] > national ) ) + 0
			RETURN
			    IF (
			        ISBLANK ( y ) || ISBLANK ( national ),
			        "Pick a year",
			        "In " & y & ", " & faster & " of " & COUNTROWS ( every_city ) & " cities grew faster than the national "
			            & FORMAT ( national, "0.0%;−0.0%" )
			    )
		displayFolder: 7 Text
		lineageTag: 337199f8-b671-50c5-a09b-9178d31c25f4

	/// Under the Cities bullet chart: which year the bars and the ticks are, and what the colours mean.
	measure 'Subtitle city growth' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( y ), "",
			        -- what green and red mean is written in the chart itself, with coloured arrows
			        y - 1 >= 2022, "Bars " & y & ", ticks " & ( y - 1 ),
			        "Bars " & y & ". No " & ( y - 1 ) & " ticks: " & ( y - 2 ) & " was a pandemic year"
			    )
		displayFolder: 7 Text
		lineageTag: c2459c91-6c6e-5bbd-9379-ba1424302b48

	measure 'Subtitle Ramadan city' =
			"Same comparison. Dark: above the national " & FORMAT ( [National Ramadan lift %], "+0.0%;−0.0%;0.0%" )
		displayFolder: 7 Text
		lineageTag: 3cbe2618-4cc6-58b4-88bc-fa56b830dd19

	/// The Sectors page's title: in how many sectors the average payment got smaller.
	measure 'Title Sectors' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR every_sector = ADDCOLUMNS ( ALL ( dim_sector[sector] ), "@change", [Average payment change %] )
			VAR counted = COUNTROWS ( FILTER ( every_sector, NOT ISBLANK ( [@change] ) ) ) + 0
			VAR smaller = COUNTROWS ( FILTER ( every_sector, [@change] < 0 ) ) + 0
			RETURN
			    IF (
			        ISBLANK ( y ) || counted = 0,
			        "Pick a year",
			        "In " & y & ", the average payment got "
			            & IF ( smaller * 2 >= counted, "smaller in " & smaller, "bigger in " & ( counted - smaller ) )
			            & " of " & counted & " sectors"
			    )
		displayFolder: 7 Text
		lineageTag: 96abc5e4-d834-51ac-80fe-d35db5d735e7

	/// Under the Sectors table: in how many sectors the payments rose and the average payment fell.
	measure 'Sectors sentence' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR every_sector =
			    ADDCOLUMNS ( ALL ( dim_sector[sector] ), "@payments", [Payments growth %], "@size", [Average payment change %] )
			VAR counted = COUNTROWS ( FILTER ( every_sector, NOT ISBLANK ( [@size] ) ) ) + 0
			VAR more_payments = COUNTROWS ( FILTER ( every_sector, [@payments] > 0 ) ) + 0
			VAR smaller = COUNTROWS ( FILTER ( every_sector, [@size] < 0 ) ) + 0
			RETURN
			    IF (
			        NOT ISBLANK ( y ) && counted > 0,
			        "Payments rose in " & more_payments & " of " & counted & " sectors while the average payment fell in " & smaller
			            -- the reading holds only when both are most of the sectors
			            & IF ( more_payments * 2 > counted && smaller * 2 > counted, ": more card payments, each one smaller.", "." )
			    )
		displayFolder: 7 Text
		lineageTag: 469e7a91-b5e5-5bf9-97a8-876231afb915

	/// Dark for a city whose Ramadan lift is above the national one, else light grey.
	measure 'Colour city Ramadan' =
			IF ( [Ramadan last week lift %] > [National Ramadan lift %], "#344054", "#D0D5DD" )
		displayFolder: 8 Colours
		lineageTag: d48f3f74-66ec-5ebd-81c4-52730b2f6eb3

	/// The weeks starting from the 21st (around payday) dark.
	measure 'Colour payday' =
			IF ( SELECTEDVALUE ( dim_date[month_days_order] ) >= 4, "#344054", "#D0D5DD" )
		displayFolder: 8 Colours
		lineageTag: 940e7eff-3c00-514c-9656-c6398cd2e4ed

	measure 'Colour Ramadan lift' =
			IF ( [Ramadan last week lift %] >= 0, "#344054", "#C81E1E" )
		displayFolder: 8 Colours
		lineageTag: b9f19075-cce4-5378-a399-cf86d745cb3f

	/// The Spent card: the total, its growth on the same weeks a year before, the weekly line.
	measure 'HTML KPI spent' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR card_value = [Spent bn SAR]
			VAR before_value = [Spent year before bn]
			VAR change_value = [Spending growth %]
			VAR number_format = "#,0.00"
			VAR spark_weeks =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_date[week_start] ), "@v", [Spent bn SAR], "@b", [Spent year before bn] ),
			        NOT ISBLANK ( [@v] )
			    )
			-- MINX and MAXX skip blanks; MIN ( a, b ) would read a blank as 0, so the year before joins the scale only if it exists
			VAR spark_lo_before = MINX ( spark_weeks, [@b] )
			VAR spark_hi_before = MAXX ( spark_weeks, [@b] )
			VAR spark_lo = IF ( ISBLANK ( spark_lo_before ), MINX ( spark_weeks, [@v] ), MIN ( MINX ( spark_weeks, [@v] ), spark_lo_before ) )
			VAR spark_hi = IF ( ISBLANK ( spark_hi_before ), MAXX ( spark_weeks, [@v] ), MAX ( MAXX ( spark_weeks, [@v] ), spark_hi_before ) )
			VAR spark_first = MINX ( spark_weeks, dim_date[week_start] )
			VAR spark_days = DATEDIFF ( spark_first, MAXX ( spark_weeks, dim_date[week_start] ), DAY )
			VAR spark_points = CONCATENATEX ( spark_weeks, FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_points_before =
			    CONCATENATEX ( FILTER ( spark_weeks, NOT ISBLANK ( [@b] ) ), FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@b] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_dot_day = MAXX ( spark_weeks, dim_date[week_start] )
			VAR spark_dot_value = MAXX ( FILTER ( spark_weeks, dim_date[week_start] = spark_dot_day ), [@v] )
			VAR spark =
			    IF (
			        COUNTROWS ( spark_weeks ) >= 2,
			        "<svg width='88' height='30' viewBox='0 0 88 30' style='flex:none'>"
			            & IF (
			                spark_points_before <> "",
			                "<polyline points='" & spark_points_before & "' fill='none' stroke='#AEB7C2' stroke-width='1.2' stroke-dasharray='2 2'/>"
			            )
			            & "<polyline points='" & spark_points & "' fill='none' stroke='#4F5966' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, spark_dot_day, DAY ), spark_days ) * 82, "0.0" ) & "' cy='"
			            & FORMAT ( 27 - DIVIDE ( spark_dot_value - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ) & "' r='2.5' fill='#344054'/></svg>"
			    )
			VAR shown_value = IF ( ISBLANK ( card_value ), UNICHAR ( 8211 ), FORMAT ( card_value, number_format ) )
			VAR comparison =
			    IF (
			        NOT ISBLANK ( change_value ),
			        SWITCH (
			        TRUE (),
			        ISBLANK ( change_value ), "",
			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
			        "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#4F5966;background:#EDF0F3'>" & "0.0%" & "</span>"
			    )
			            & "<span style='margin-left:6px'>vs " & FORMAT ( before_value, number_format )
			            & IF (
			                FORMAT ( [Spent same weeks bn], number_format ) <> FORMAT ( card_value, number_format ),
			                ", " & COUNTROWS (
			                    INTERSECT (
			                        VALUES ( dim_date[week_of_year] ),
			                        CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			                    )
			                ) & " weeks of " & ( this_year - 1 ),
			                " in " & ( this_year - 1 )
			            ) & "</span>"
			    )
			VAR note_text = [Note spent]
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#13161B;height:88px;overflow:hidden'>"
			        & "<div style='font-size:12px;line-height:16px;color:#4F5966'>Spent (bn SAR)</div>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;height:32px;margin-top:2px'>"
			        & "<div style='font-size:26px;line-height:32px;font-weight:600'>" & shown_value & "</div>" & spark & "</div>"
			        & "<div style='font-size:11px;line-height:18px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & comparison & "</div>"
			        & "<div style='font-size:11px;line-height:14px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & note_text & "</div>"
			        & "</div>"
		displayFolder: 9 HTML
		lineageTag: 31277376-8eec-5bcb-8de9-9c0224106dd6

	/// The Payments card: how many card payments, and their growth.
	measure 'HTML KPI payments' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR card_value = [Payments m]
			VAR before_value = [Payments year before m]
			VAR change_value = [Payments growth %]
			VAR number_format = IF ( [Payments m] < 100, "#,0.0", "#,0" )
			VAR spark_weeks =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_date[week_start] ), "@v", [Payments m], "@b", [Payments year before m] ),
			        NOT ISBLANK ( [@v] )
			    )
			-- MINX and MAXX skip blanks; MIN ( a, b ) would read a blank as 0, so the year before joins the scale only if it exists
			VAR spark_lo_before = MINX ( spark_weeks, [@b] )
			VAR spark_hi_before = MAXX ( spark_weeks, [@b] )
			VAR spark_lo = IF ( ISBLANK ( spark_lo_before ), MINX ( spark_weeks, [@v] ), MIN ( MINX ( spark_weeks, [@v] ), spark_lo_before ) )
			VAR spark_hi = IF ( ISBLANK ( spark_hi_before ), MAXX ( spark_weeks, [@v] ), MAX ( MAXX ( spark_weeks, [@v] ), spark_hi_before ) )
			VAR spark_first = MINX ( spark_weeks, dim_date[week_start] )
			VAR spark_days = DATEDIFF ( spark_first, MAXX ( spark_weeks, dim_date[week_start] ), DAY )
			VAR spark_points = CONCATENATEX ( spark_weeks, FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_points_before =
			    CONCATENATEX ( FILTER ( spark_weeks, NOT ISBLANK ( [@b] ) ), FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@b] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_dot_day = MAXX ( spark_weeks, dim_date[week_start] )
			VAR spark_dot_value = MAXX ( FILTER ( spark_weeks, dim_date[week_start] = spark_dot_day ), [@v] )
			VAR spark =
			    IF (
			        COUNTROWS ( spark_weeks ) >= 2,
			        "<svg width='88' height='30' viewBox='0 0 88 30' style='flex:none'>"
			            & IF (
			                spark_points_before <> "",
			                "<polyline points='" & spark_points_before & "' fill='none' stroke='#AEB7C2' stroke-width='1.2' stroke-dasharray='2 2'/>"
			            )
			            & "<polyline points='" & spark_points & "' fill='none' stroke='#4F5966' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, spark_dot_day, DAY ), spark_days ) * 82, "0.0" ) & "' cy='"
			            & FORMAT ( 27 - DIVIDE ( spark_dot_value - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ) & "' r='2.5' fill='#344054'/></svg>"
			    )
			VAR shown_value = IF ( ISBLANK ( card_value ), UNICHAR ( 8211 ), FORMAT ( card_value, number_format ) )
			VAR comparison =
			    IF (
			        NOT ISBLANK ( change_value ),
			        SWITCH (
			        TRUE (),
			        ISBLANK ( change_value ), "",
			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
			        "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#4F5966;background:#EDF0F3'>" & "0.0%" & "</span>"
			    )
			            & "<span style='margin-left:6px'>vs " & FORMAT ( before_value, number_format )
			            & IF (
			                FORMAT ( [Payments same weeks m], number_format ) <> FORMAT ( card_value, number_format ),
			                ", " & COUNTROWS (
			                    INTERSECT (
			                        VALUES ( dim_date[week_of_year] ),
			                        CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			                    )
			                ) & " weeks of " & ( this_year - 1 ),
			                " in " & ( this_year - 1 )
			            ) & "</span>"
			    )
			VAR note_text = ""
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#13161B;height:88px;overflow:hidden'>"
			        & "<div style='font-size:12px;line-height:16px;color:#4F5966'>Payments (millions)</div>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;height:32px;margin-top:2px'>"
			        & "<div style='font-size:26px;line-height:32px;font-weight:600'>" & shown_value & "</div>" & spark & "</div>"
			        & "<div style='font-size:11px;line-height:18px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & comparison & "</div>"
			        & "<div style='font-size:11px;line-height:14px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & note_text & "</div>"
			        & "</div>"
		displayFolder: 9 HTML
		lineageTag: 5c45e556-8a68-537f-8337-7254754ff78b

	/// The Average payment card: spent divided by payments, and its change.
	measure 'HTML KPI average payment' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR card_value = [Average payment SAR]
			VAR before_value = [Average payment year before SAR]
			VAR change_value = [Average payment change %]
			VAR number_format = "#,0.0"
			VAR spark_weeks =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_date[week_start] ), "@v", [Average payment SAR], "@b", [Average payment year before SAR] ),
			        NOT ISBLANK ( [@v] )
			    )
			-- MINX and MAXX skip blanks; MIN ( a, b ) would read a blank as 0, so the year before joins the scale only if it exists
			VAR spark_lo_before = MINX ( spark_weeks, [@b] )
			VAR spark_hi_before = MAXX ( spark_weeks, [@b] )
			VAR spark_lo = IF ( ISBLANK ( spark_lo_before ), MINX ( spark_weeks, [@v] ), MIN ( MINX ( spark_weeks, [@v] ), spark_lo_before ) )
			VAR spark_hi = IF ( ISBLANK ( spark_hi_before ), MAXX ( spark_weeks, [@v] ), MAX ( MAXX ( spark_weeks, [@v] ), spark_hi_before ) )
			VAR spark_first = MINX ( spark_weeks, dim_date[week_start] )
			VAR spark_days = DATEDIFF ( spark_first, MAXX ( spark_weeks, dim_date[week_start] ), DAY )
			VAR spark_points = CONCATENATEX ( spark_weeks, FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_points_before =
			    CONCATENATEX ( FILTER ( spark_weeks, NOT ISBLANK ( [@b] ) ), FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@b] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_dot_day = MAXX ( spark_weeks, dim_date[week_start] )
			VAR spark_dot_value = MAXX ( FILTER ( spark_weeks, dim_date[week_start] = spark_dot_day ), [@v] )
			VAR spark =
			    IF (
			        COUNTROWS ( spark_weeks ) >= 2,
			        "<svg width='88' height='30' viewBox='0 0 88 30' style='flex:none'>"
			            & IF (
			                spark_points_before <> "",
			                "<polyline points='" & spark_points_before & "' fill='none' stroke='#AEB7C2' stroke-width='1.2' stroke-dasharray='2 2'/>"
			            )
			            & "<polyline points='" & spark_points & "' fill='none' stroke='#4F5966' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, spark_dot_day, DAY ), spark_days ) * 82, "0.0" ) & "' cy='"
			            & FORMAT ( 27 - DIVIDE ( spark_dot_value - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ) & "' r='2.5' fill='#344054'/></svg>"
			    )
			VAR shown_value = IF ( ISBLANK ( card_value ), UNICHAR ( 8211 ), FORMAT ( card_value, number_format ) )
			VAR comparison =
			    IF (
			        NOT ISBLANK ( change_value ),
			        SWITCH (
			        TRUE (),
			        ISBLANK ( change_value ), "",
			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
			        "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#4F5966;background:#EDF0F3'>" & "0.0%" & "</span>"
			    )
			            & "<span style='margin-left:6px'>vs " & FORMAT ( before_value, number_format )
			            & IF (
			                FORMAT ( [Average payment same weeks SAR], number_format ) <> FORMAT ( card_value, number_format ),
			                ", " & COUNTROWS (
			                    INTERSECT (
			                        VALUES ( dim_date[week_of_year] ),
			                        CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			                    )
			                ) & " weeks of " & ( this_year - 1 ),
			                " in " & ( this_year - 1 )
			            ) & "</span>"
			    )
			VAR note_text = ""
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#13161B;height:88px;overflow:hidden'>"
			        & "<div style='font-size:12px;line-height:16px;color:#4F5966'>Average payment (SAR)</div>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;height:32px;margin-top:2px'>"
			        & "<div style='font-size:26px;line-height:32px;font-weight:600'>" & shown_value & "</div>" & spark & "</div>"
			        & "<div style='font-size:11px;line-height:18px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & comparison & "</div>"
			        & "<div style='font-size:11px;line-height:14px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & note_text & "</div>"
			        & "</div>"
		displayFolder: 9 HTML
		lineageTag: c8d1456a-0a80-5d7a-bc10-77f42c8012bb

	/// The Biggest week card: the peak week, against the peak of the same weeks a year before.
	measure 'HTML KPI biggest week' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR card_value = [Biggest week bn]
			VAR before_value = [Biggest week year before bn]
			VAR change_value = [Biggest week change %]
			VAR number_format = "#,0.00"
			VAR spark_weeks =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_date[week_start] ), "@v", [Spent bn SAR], "@b", [Spent year before bn] ),
			        NOT ISBLANK ( [@v] )
			    )
			-- MINX and MAXX skip blanks; MIN ( a, b ) would read a blank as 0, so the year before joins the scale only if it exists
			VAR spark_lo_before = MINX ( spark_weeks, [@b] )
			VAR spark_hi_before = MAXX ( spark_weeks, [@b] )
			VAR spark_lo = IF ( ISBLANK ( spark_lo_before ), MINX ( spark_weeks, [@v] ), MIN ( MINX ( spark_weeks, [@v] ), spark_lo_before ) )
			VAR spark_hi = IF ( ISBLANK ( spark_hi_before ), MAXX ( spark_weeks, [@v] ), MAX ( MAXX ( spark_weeks, [@v] ), spark_hi_before ) )
			VAR spark_first = MINX ( spark_weeks, dim_date[week_start] )
			VAR spark_days = DATEDIFF ( spark_first, MAXX ( spark_weeks, dim_date[week_start] ), DAY )
			VAR spark_points = CONCATENATEX ( spark_weeks, FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_points_before =
			    CONCATENATEX ( FILTER ( spark_weeks, NOT ISBLANK ( [@b] ) ), FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@b] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_dot_day = MAXX ( TOPN ( 1, spark_weeks, [@v], DESC ), dim_date[week_start] )
			VAR spark_dot_value = MAXX ( FILTER ( spark_weeks, dim_date[week_start] = spark_dot_day ), [@v] )
			VAR spark =
			    IF (
			        COUNTROWS ( spark_weeks ) >= 2,
			        "<svg width='88' height='30' viewBox='0 0 88 30' style='flex:none'>"
			            & IF (
			                spark_points_before <> "",
			                "<polyline points='" & spark_points_before & "' fill='none' stroke='#AEB7C2' stroke-width='1.2' stroke-dasharray='2 2'/>"
			            )
			            & "<polyline points='" & spark_points & "' fill='none' stroke='#4F5966' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, spark_dot_day, DAY ), spark_days ) * 82, "0.0" ) & "' cy='"
			            & FORMAT ( 27 - DIVIDE ( spark_dot_value - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ) & "' r='2.5' fill='#344054'/></svg>"
			    )
			VAR shown_value = IF ( ISBLANK ( card_value ), UNICHAR ( 8211 ), FORMAT ( card_value, number_format ) )
			VAR comparison =
			    IF (
			        NOT ISBLANK ( change_value ),
			        SWITCH (
			        TRUE (),
			        ISBLANK ( change_value ), "",
			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
			        "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#4F5966;background:#EDF0F3'>" & "0.0%" & "</span>"
			    )
			            & "<span style='margin-left:6px'>vs " & FORMAT ( before_value, number_format )
			            & " in " & ( this_year - 1 ) & "</span>"
			    )
			VAR note_text = [Note biggest week]
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#13161B;height:88px;overflow:hidden'>"
			        & "<div style='font-size:12px;line-height:16px;color:#4F5966'>Biggest week (bn SAR)</div>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;height:32px;margin-top:2px'>"
			        & "<div style='font-size:26px;line-height:32px;font-weight:600'>" & shown_value & "</div>" & spark & "</div>"
			        & "<div style='font-size:11px;line-height:18px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & comparison & "</div>"
			        & "<div style='font-size:11px;line-height:14px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & note_text & "</div>"
			        & "</div>"
		displayFolder: 9 HTML
		lineageTag: ca8b6520-8922-5bcf-99a5-59bea5fe36dd

	/// One row of the Sectors table; the first row in the current sort also holds the column headers, the last one the 'All sectors' total and the footer.
	measure 'HTML sector row' =
			VAR sector_spent = [Spent bn SAR]
			VAR sector_growth = [Spending growth %]
			VAR sector_payments = [Payments growth %]
			VAR sector_average = [Average payment SAR]
			VAR sector_change = [Average payment change %]
			VAR every_sector = ADDCOLUMNS ( ALLSELECTED ( dim_sector[sector] ), "@change", [Average payment change %], "@key", [Sector sort value] )
			VAR sort_now = [Sector sort value]
			VAR position = COUNTROWS ( FILTER ( every_sector, [@key] > sort_now ) ) + 1
			VAR total_0 = CALCULATE ( [Spent bn SAR], REMOVEFILTERS ( dim_sector ) )
			VAR total_1 = CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_sector ) )
			VAR total_2 = CALCULATE ( [Payments growth %], REMOVEFILTERS ( dim_sector ) )
			VAR total_3 = CALCULATE ( [Average payment SAR], REMOVEFILTERS ( dim_sector ) )
			VAR total_4 = CALCULATE ( [Average payment change %], REMOVEFILTERS ( dim_sector ) )
			-- one scale for every row, the total included, with 0 always on it
			VAR change_low = MIN ( MIN ( MINX ( every_sector, [@change] ), total_4 ), 0 )
			VAR change_high = MAX ( MAX ( MAXX ( every_sector, [@change] ), total_4 ), 0 )
			VAR sector_line =
			    "<div style='display:flex;align-items:center;height:23px;border-bottom:1px solid #EDF0F3;font-size:13px;font-weight:400;color:#13161B'>"
			            & "<div style='width:190px;text-align:left;flex:none'>" & SELECTEDVALUE ( dim_sector[sector] ) & "</div>"
			            & "<div style='width:104px;text-align:center;flex:none'>" & FORMAT ( sector_spent, "#,0.00" ) & "</div>"
			            & "<div style='width:116px;text-align:center;flex:none'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( sector_growth ), "",
			        ROUND ( sector_growth, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:54px;text-align:right'>" & "+" & FORMAT ( sector_growth, "0.0%" ) & "</span></span>",
			        ROUND ( sector_growth, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:54px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_growth ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:54px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:116px;text-align:center;flex:none'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( sector_payments ), "",
			        ROUND ( sector_payments, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:54px;text-align:right'>" & "+" & FORMAT ( sector_payments, "0.0%" ) & "</span></span>",
			        ROUND ( sector_payments, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:54px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_payments ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:54px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:124px;text-align:center;flex:none'>" & FORMAT ( sector_average, "#,0.0" ) & "</div>"
			            & "<div style='width:24px;text-align:center;flex:none'>" & "" & "</div>"
			            & "<div style='width:420px;text-align:center;flex:none'>" & "<div style='display:flex;width:420px;height:23px'><div style='display:flex;justify-content:flex-end;align-items:center;width:" & FORMAT ( ( 56 + DIVIDE ( 0 - change_low, change_high - change_low ) * 308 ), "0.0" ) & "px'>" & IF ( ROUND ( sector_change, 3 ) < 0, "<span style='font-size:12px;font-weight:600;color:#C81E1E;margin:0 5px'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_change ), "0.0%" ) & "</span>" & "<div style='flex:none;height:12px;width:" & FORMAT ( DIVIDE ( ABS ( sector_change ), change_high - change_low ) * 308, "0.0" ) & "px;background:#C81E1E'></div>" ) & "</div><div style='display:flex;align-items:center;flex:1;border-left:1px solid #AEB7C2'>" & IF ( ROUND ( sector_change, 3 ) > 0, "<div style='flex:none;height:12px;width:" & FORMAT ( DIVIDE ( ABS ( sector_change ), change_high - change_low ) * 308, "0.0" ) & "px;background:#16A34A'></div>" & "<span style='font-size:12px;font-weight:600;color:#15803D;margin:0 5px'>" & "+" & FORMAT ( sector_change, "0.0%" ) & "</span>", IF ( NOT ISBLANK ( sector_change ) && ROUND ( sector_change, 3 ) >= 0, "<span style='font-size:12px;font-weight:600;color:#4F5966;margin:0 5px'>" & "0.0%" & "</span>" ) ) & "</div></div>" & "</div>"
			            & "</div>"
			VAR total_line =
			    "<div style='display:flex;align-items:center;height:23px;border-top:1px solid #13161B;margin-top:-1px;font-size:13px;font-weight:600;color:#13161B'>"
			            & "<div style='width:190px;text-align:left;flex:none'>" & "All sectors" & "</div>"
			            & "<div style='width:104px;text-align:center;flex:none'>" & FORMAT ( total_0, "#,0.00" ) & "</div>"
			            & "<div style='width:116px;text-align:center;flex:none'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( total_1 ), "",
			        ROUND ( total_1, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:54px;text-align:right'>" & "+" & FORMAT ( total_1, "0.0%" ) & "</span></span>",
			        ROUND ( total_1, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:54px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_1 ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:54px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:116px;text-align:center;flex:none'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( total_2 ), "",
			        ROUND ( total_2, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:54px;text-align:right'>" & "+" & FORMAT ( total_2, "0.0%" ) & "</span></span>",
			        ROUND ( total_2, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:54px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_2 ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:54px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:124px;text-align:center;flex:none'>" & FORMAT ( total_3, "#,0.0" ) & "</div>"
			            & "<div style='width:24px;text-align:center;flex:none'>" & "" & "</div>"
			            & "<div style='width:420px;text-align:center;flex:none'>" & "<div style='display:flex;width:420px;height:23px'><div style='display:flex;justify-content:flex-end;align-items:center;width:" & FORMAT ( ( 56 + DIVIDE ( 0 - change_low, change_high - change_low ) * 308 ), "0.0" ) & "px'>" & IF ( ROUND ( total_4, 3 ) < 0, "<span style='font-size:12px;font-weight:700;color:#C81E1E;margin:0 5px'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_4 ), "0.0%" ) & "</span>" & "<div style='flex:none;height:12px;width:" & FORMAT ( DIVIDE ( ABS ( total_4 ), change_high - change_low ) * 308, "0.0" ) & "px;background:#C81E1E'></div>" ) & "</div><div style='display:flex;align-items:center;flex:1;border-left:1px solid #AEB7C2'>" & IF ( ROUND ( total_4, 3 ) > 0, "<div style='flex:none;height:12px;width:" & FORMAT ( DIVIDE ( ABS ( total_4 ), change_high - change_low ) * 308, "0.0" ) & "px;background:#16A34A'></div>" & "<span style='font-size:12px;font-weight:700;color:#15803D;margin:0 5px'>" & "+" & FORMAT ( total_4, "0.0%" ) & "</span>", IF ( NOT ISBLANK ( total_4 ) && ROUND ( total_4, 3 ) >= 0, "<span style='font-size:12px;font-weight:700;color:#4F5966;margin:0 5px'>" & "0.0%" & "</span>" ) ) & "</div></div>" & "</div>"
			            & "</div>"
			VAR footer =
			    "<div style='display:flex;justify-content:space-between;align-items:center;margin-top:12px'>"
			        & "<div style='font-size:12px;color:#4F5966'>" & [Sectors sentence] & "</div>"
			        & "<div style='font-size:13px;color:#13161B;background:#F2F4F7;border-radius:6px;padding:6px 12px;white-space:nowrap'>"
			        & "Spending = number of payments &times; average payment</div></div>"
			-- The row starts with its place in the current sort as hidden text ('<!--01-->'), and the visual sorts by this measure
			-- (as the Cities scorecard does since review round 4): the tooltip then shows readable values, not the sort value.
			RETURN
			    IF (
			        HASONEVALUE ( dim_sector[sector] ) && NOT ISBLANK ( sector_spent ),
			        "<!--" & FORMAT ( position, "00" ) & "-->"
			            & "<div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums'>"
			            & IF ( position = 1, "<div style='display:flex;align-items:flex-end;height:24px;padding-bottom:4px;border-bottom:1px solid #13161B;font-size:12px;font-weight:600;color:#13161B;line-height:16px'><div style='width:190px;text-align:left;white-space:nowrap;flex:none'>Sector</div><div style='width:104px;text-align:center;white-space:nowrap;flex:none'>Spent (bn SAR)</div><div style='width:116px;text-align:center;white-space:nowrap;flex:none'>Spending growth</div><div style='width:116px;text-align:center;white-space:nowrap;flex:none'>Payments growth</div><div style='width:124px;text-align:center;white-space:nowrap;flex:none'>Avg. payment (SAR)</div><div style='width:24px;text-align:center;white-space:nowrap;flex:none'></div><div style='width:420px;text-align:center;white-space:nowrap;flex:none'>Avg. payment change</div></div>" ) & sector_line
			            & IF ( position = COUNTROWS ( every_sector ), total_line & footer )
			            & "</div>"
			    )
		displayFolder: 9 HTML
		lineageTag: 013ccb5a-71c2-5d06-ba52-823dcc2a3220

	/// The line under the Sectors table's title: how the rows are sorted, and what the green and red arrows mean.
	measure 'HTML sector subtitle' =
			VAR every_sector = ADDCOLUMNS ( ALLSELECTED ( dim_sector[sector] ), "@change", [Average payment change %] )
			VAR counted = COUNTROWS ( FILTER ( every_sector, NOT ISBLANK ( [@change] ) ) )
			VAR bigger = COUNTROWS ( FILTER ( every_sector, [@change] > 0 ) ) + 0
			VAR pick = SELECTEDVALUE ( 'Sort sector'[Sort], "Avg. payment change" )
			VAR sorted_text =
			    SWITCH (
			        pick,
			        "Spent", "Largest first.",
			        "Spending growth", "Fastest spending growth first.",
			        "Sorted by the change in the average payment: " & bigger & " bigger, " & ( counted - bigger ) & " smaller."
			    )
			RETURN
			    IF (
			        counted > 0,
			        "<div style='font-family:Segoe UI,sans-serif;font-size:12px;line-height:16px;color:#4F5966;white-space:nowrap'>"
			            & sorted_text & " Changes on the same weeks a year before: <span style='color:#15803D'>&#9650;</span> up, "
			            & "<span style='color:#C81E1E'>&#9660;</span> down.</div>"
			    )
		displayFolder: 9 HTML
		lineageTag: 843fcd68-b472-566e-950d-3e9a580a80d2

	/// One row of the Cities scorecard; the first row in the current sort also holds the column headers, the last one the colour key.
	measure 'HTML city row' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR city_growth = [Spending growth %]
			VAR city_before = [Spending growth year before %]
			VAR city_share = [Share of national %]
			VAR city_average = [Average payment SAR]
			VAR national_growth = [National growth %]
			VAR national_before = CALCULATE ( [Spending growth year before %], REMOVEFILTERS ( dim_city ) )
			VAR national_average = [National average payment SAR]
			VAR every_city =
			    ADDCOLUMNS (
			        ALLSELECTED ( dim_city[city] ),
			        "@growth", [Spending growth %], "@before", [Spending growth year before %],
			        "@share", [Share of national %], "@average", [Average payment SAR], "@key", [City sort value]
			    )
			-- one scale for every row: 0, the country, this year and the year before (MINX and MAXX skip blank ticks)
			VAR low_now = MIN ( MIN ( MINX ( every_city, [@growth] ), national_growth ), 0 )
			VAR high_now = MAX ( MAXX ( every_city, [@growth] ), national_growth )
			VAR low_before = MINX ( every_city, [@before] )
			VAR high_before = MAXX ( every_city, [@before] )
			VAR growth_low = IF ( ISBLANK ( low_before ), low_now, MIN ( low_now, low_before ) )
			VAR growth_high = IF ( ISBLANK ( high_before ), high_now, MAX ( high_now, high_before ) ) * 1.02
			VAR share_most = MAXX ( every_city, [@share] )
			VAR average_most = MAXX ( every_city, [@average] )
			VAR ticks = COUNTROWS ( FILTER ( every_city, NOT ISBLANK ( [@before] ) ) )
			VAR sort_now = [City sort value]
			VAR position = COUNTROWS ( FILTER ( every_city, [@key] > sort_now ) ) + 1
			-- the change in points, from the rounded rates the reader sees
			VAR change_pts = IF ( NOT ISBLANK ( city_before ), ( ROUND ( city_growth, 3 ) - ROUND ( city_before, 3 ) ) * 100 )
			VAR faster = change_pts > 0
			VAR slower = change_pts < 0
			VAR national_change_pts = IF ( NOT ISBLANK ( national_before ), ( ROUND ( national_growth, 3 ) - ROUND ( national_before, 3 ) ) * 100 )
			VAR national_faster = national_change_pts > 0
			VAR national_slower = national_change_pts < 0
			VAR bar_colour = IF ( faster, "#16A34A", IF ( slower, "#C81E1E", "#D0D5DD" ) )
			VAR x_zero = ( 4 + DIVIDE ( 0 - growth_low, growth_high - growth_low ) * 296 )
			VAR x_growth = ( 4 + DIVIDE ( city_growth - growth_low, growth_high - growth_low ) * 296 )
			VAR x_before = ( 4 + DIVIDE ( city_before - growth_low, growth_high - growth_low ) * 296 )
			VAR x_national = ( 4 + DIVIDE ( national_growth - growth_low, growth_high - growth_low ) * 296 )
			VAR growth_text = IF ( city_growth >= 0, "+", UNICHAR ( 8722 ) ) & FORMAT ( ABS ( city_growth ), "0.0%" )
			VAR before_text =
			    IF ( ISBLANK ( city_before ), "<span style='color:#646E7B'>" & UNICHAR ( 8211 ) & "</span>",
			        IF ( city_before >= 0, "+", UNICHAR ( 8722 ) ) & FORMAT ( ABS ( city_before ), "0.0%" ) )
			VAR national_text = IF ( national_growth >= 0, "+", UNICHAR ( 8722 ) ) & FORMAT ( ABS ( national_growth ), "0.0%" )
			VAR national_before_text =
			    IF ( ISBLANK ( national_before ), "<span style='color:#646E7B'>" & UNICHAR ( 8211 ) & "</span>",
			        IF ( national_before >= 0, "+", UNICHAR ( 8722 ) ) & FORMAT ( ABS ( national_before ), "0.0%" ) )
			VAR chart_header = "Bar " & y & IF ( ticks > 0, ", tick " & ( y - 1 ) )
			VAR graphic =
			    "<svg width='304' height='36' viewBox='0 0 304 36' style='flex:none;display:block'>"
			        & "<polyline points='" & FORMAT ( x_zero, "0.0" ) & ",0 " & FORMAT ( x_zero, "0.0" ) & ",36' fill='none' stroke='" & "#AEB7C2" & "' stroke-width='1'/>"
			        & "<polyline points='" & FORMAT ( x_zero, "0.0" ) & ",18.0 " & FORMAT ( x_growth, "0.0" ) & ",18.0' fill='none' stroke='" & bar_colour & "' stroke-width='16'/>"
			        & "<polyline points='" & FORMAT ( x_national, "0.0" ) & ",0 " & FORMAT ( x_national, "0.0" ) & ",36' fill='none' stroke='" & "#646E7B" & "' stroke-width='1' stroke-dasharray='3 3'/>"
			        & IF ( NOT ISBLANK ( city_before ), "<polyline points='" & FORMAT ( x_before, "0.0" ) & ",6.0 " & FORMAT ( x_before, "0.0" ) & ",30.0' fill='none' stroke='" & "#344054" & "' stroke-width='2.5'/>" )
			        & "</svg>"
			VAR city_line =
			    "<div style='display:flex;align-items:center;height:36px;border-bottom:1px solid #EDF0F3;font-size:13px;color:#13161B'>"
			        & "<div style='width:140px;flex:none;white-space:nowrap'>" & SELECTEDVALUE ( dim_city[city] ) & "</div>"
			        & "<div style='width:84px;flex:none;text-align:center'><span style='display:inline-block;width:52px;text-align:right'>" & growth_text & "</span></div>"
			        & "<div style='width:124px;flex:none;text-align:center'>" & IF ( NOT ISBLANK ( change_pts ), "<span style='display:inline-flex;font-size:12px;font-weight:600;color:" & IF ( faster, "#15803D", IF ( slower, "#C81E1E", "#4F5966" ) ) & "'><span style='width:14px;text-align:center'>" & IF ( faster, UNICHAR ( 9650 ), IF ( slower, UNICHAR ( 9660 ), "" ) ) & "</span><span style='width:32px;text-align:right'>" & FORMAT ( ABS ( change_pts ), "0.0" ) & "</span></span>", "<span style='color:#646E7B'>" & UNICHAR ( 8211 ) & "</span>" ) & "</div>"
			        & "<div style='width:16px;flex:none'></div>"
			        & graphic
			        & "<div style='width:40px;flex:none'></div>"
			        & "<div style='width:190px;flex:none;box-sizing:border-box;display:flex;align-items:center;height:36px;border-left:1px solid #AEB7C2'><div style='flex:none;height:16px;width:" & FORMAT ( DIVIDE ( city_share, share_most ) * 130, "0.0" ) & "px;background:#667085'></div><span style='margin-left:6px'>" & FORMAT ( city_share, "0.0%" ) & "</span></div>"
			        & "<div style='width:20px;flex:none'></div>"
			        & "<div style='width:190px;flex:none;box-sizing:border-box;display:flex;align-items:center;height:36px;border-left:1px solid #AEB7C2'><div style='flex:none;height:16px;width:" & FORMAT ( DIVIDE ( city_average, average_most ) * 130, "0.0" ) & "px;background:" & IF ( city_average > national_average, "#344054", "#D0D5DD" ) & "'></div><span style='margin-left:6px'>" & FORMAT ( city_average, "#,0.0" ) & "</span></div>"
			        & "</div>"
			VAR footer = 
			    "<div style='display:flex;height:18px;font-size:11px;color:#646E7B'><div style='width:364px;flex:none'></div>"
			        & "<svg width='304' height='18' viewBox='0 0 304 18' style='flex:none;display:block'>"
			        & "<text x='" & FORMAT ( MIN ( MAX ( x_national, 44 ), 260 ), "0.0" ) & "' y='13' font-size='11' fill='#646E7B' "
			        & "text-anchor='middle'>National " & national_text & "</text></svg>"
			        & "<div style='width:250px;flex:none'></div>"
			        & "<div style='width:190px;flex:none;line-height:18px'>Dark: above the national " & FORMAT ( national_average, "0.0" ) & "</div></div>"
			        & IF (
			            ticks > 0,
			            "<div style='display:flex;margin-top:6px;font-size:12px;font-weight:600'><div style='width:364px;flex:none'></div>"
			                & "<span style='color:#15803D'>&#9650; Faster than a year before</span>"
			                & "<span style='color:#C81E1E;margin-left:24px'>&#9660; Slower</span></div>"
			        )
			-- The row starts with its place in the current sort as hidden text ('<!--01-->'), and the visual sorts by this measure:
			-- the sort no longer needs the sort value in the visual's tooltip fields, so the tooltip can show readable values.
			RETURN
			    IF (
			        HASONEVALUE ( dim_city[city] ) && NOT ISBLANK ( city_growth ),
			        "<!--" & FORMAT ( position, "00" ) & "-->"
			            & "<div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums'>"
			            & IF ( position = 1, "<div style='display:flex;align-items:flex-end;height:24px;padding-bottom:4px;border-bottom:1px solid #13161B;font-size:12px;font-weight:600;color:#13161B;line-height:16px'><div style='width:140px;flex:none;white-space:nowrap;text-align:left'>City</div><div style='width:84px;flex:none;white-space:nowrap;text-align:center'>Growth " & y & "</div><div style='width:124px;flex:none;white-space:nowrap;text-align:center'>Change vs " & ( y - 1 ) & " (pts)</div><div style='width:16px;flex:none;white-space:nowrap;text-align:left'></div><div style='width:304px;flex:none;white-space:nowrap;text-align:left'>" & chart_header & "</div><div style='width:40px;flex:none;white-space:nowrap;text-align:left'></div><div style='width:190px;flex:none;white-space:nowrap;text-align:left'>Share of national spending</div><div style='width:20px;flex:none;white-space:nowrap;text-align:left'></div><div style='width:190px;flex:none;white-space:nowrap;text-align:left'>Average payment (SAR)</div></div>" ) & city_line
			            & IF ( position = COUNTROWS ( every_city ), footer )
			            & "</div>"
			    )
		displayFolder: 9 HTML
		lineageTag: c125da93-f8dd-59d9-aa63-2d2aa711d776

	/// Hover text on the Cities scorecard: the city's growth a year before.
	measure 'Tooltip city growth before' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			VAR growth_before = [Spending growth year before %]
			RETURN
			    IF (
			        ISBLANK ( growth_before ),
			        "None: " & ( y - 2 ) & " was a pandemic year",
			        IF ( growth_before >= 0, "+", UNICHAR ( 8722 ) ) & FORMAT ( ABS ( growth_before ), "0.0%" )
			    )
		displayFolder: 10 Tooltips
		lineageTag: e1a35798-36c0-5526-8b5a-d914df69a907

	/// Hover text on the Cities scorecard: this year's growth against last year's, in points, from the rounded rates (as in the table).
	measure 'Tooltip city change' =
			VAR growth_before = [Spending growth year before %]
			VAR change_pts = ( ROUND ( [Spending growth %], 3 ) - ROUND ( growth_before, 3 ) ) * 100
			RETURN
			    IF (
			        ISBLANK ( growth_before ),
			        "None",
			        IF ( change_pts > 0, UNICHAR ( 9650 ) & " ", IF ( change_pts < 0, UNICHAR ( 9660 ) & " " ) )
			            & FORMAT ( ABS ( change_pts ), "0.0" ) & " pts " & IF ( change_pts > 0, "faster", IF ( change_pts < 0, "slower", "the same" ) )
			    )
		displayFolder: 10 Tooltips
		lineageTag: 04ac7816-e10f-56ec-b45f-558e0de06c86

	/// The line under the Cities scorecard's title: which years the bars and ticks are, the national growth and the national average payment.
	measure 'HTML city subtitle' =
			VAR y = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    IF (
			        NOT ISBLANK ( [National growth %] ),
			        "<div style='font-family:Segoe UI,sans-serif;font-size:12px;line-height:16px;color:#4F5966;white-space:nowrap'>"
			            & "Growth on the same weeks a year before."
			            & IF ( y - 1 < 2022, " Nothing to compare " & ( y - 1 ) & " with: " & ( y - 2 ) & " was a pandemic year." )
			            & " One row per city, so a city reads across.</div>"
			    )
		displayFolder: 9 HTML
		lineageTag: 3dd1b61a-f3f7-58fd-b317-8afa356df26e

	/// Spent card tooltip: the total.
	measure 'Tooltip spent' =
			VAR shown = [Spent bn SAR]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( shown, "#,0.00" ) )
		displayFolder: 10 Tooltips
		lineageTag: 201c15fe-ce6e-55c9-80db-dbeab72a3607

	/// Spent card tooltip: the same weeks a year before.
	measure 'Tooltip spent year before' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR year_before_value = [Spent year before bn]
			VAR number_format = "#,0.00"
			VAR weeks_note = IF (
			        FORMAT ( [Spent same weeks bn], number_format ) <> FORMAT ( [Spent bn SAR], number_format ),
			        " (" & COUNTROWS (
			            INTERSECT (
			                VALUES ( dim_date[week_of_year] ),
			                CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			            )
			        ) & " weeks of " & ( this_year - 1 ) & ")"
			    )
			RETURN
			    IF ( ISBLANK ( year_before_value ), UNICHAR ( 8211 ), FORMAT ( year_before_value, number_format ) & weeks_note )
		displayFolder: 10 Tooltips
		lineageTag: 8f5fac19-22ee-55ab-9b43-4ba629799ed4

	/// Spent card tooltip: the growth.
	measure 'Tooltip spending growth' =
			VAR shown = [Spending growth %]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( ROUND ( shown, 3 ), "+0.0%;" & UNICHAR ( 8722 ) & "0.0%;0.0%" ) )
		displayFolder: 10 Tooltips
		lineageTag: dc35be02-3e36-5254-aaf9-056f0d95b03d

	/// Payments card tooltip: the number of payments, millions.
	measure 'Tooltip payments' =
			VAR shown = [Payments m]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( shown, IF ( [Payments m] < 100, "#,0.0", "#,0" ) ) )
		displayFolder: 10 Tooltips
		lineageTag: d5b2a8d6-36de-5e18-8a9b-172b0e11d279

	/// Payments card tooltip: the same weeks a year before.
	measure 'Tooltip payments year before' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR year_before_value = [Payments year before m]
			VAR number_format = IF ( [Payments m] < 100, "#,0.0", "#,0" )
			VAR weeks_note = IF (
			        FORMAT ( [Payments same weeks m], number_format ) <> FORMAT ( [Payments m], number_format ),
			        " (" & COUNTROWS (
			            INTERSECT (
			                VALUES ( dim_date[week_of_year] ),
			                CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			            )
			        ) & " weeks of " & ( this_year - 1 ) & ")"
			    )
			RETURN
			    IF ( ISBLANK ( year_before_value ), UNICHAR ( 8211 ), FORMAT ( year_before_value, number_format ) & weeks_note )
		displayFolder: 10 Tooltips
		lineageTag: 40b962ff-5943-5650-88d7-b1d3ade6a500

	/// Payments card tooltip: the growth.
	measure 'Tooltip payments growth' =
			VAR shown = [Payments growth %]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( ROUND ( shown, 3 ), "+0.0%;" & UNICHAR ( 8722 ) & "0.0%;0.0%" ) )
		displayFolder: 10 Tooltips
		lineageTag: af13ef69-45a8-5d78-bd9b-ed84503efd5d

	/// Average payment card tooltip: the average payment, SAR.
	measure 'Tooltip average payment' =
			VAR shown = [Average payment SAR]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( shown, "#,0.0" ) )
		displayFolder: 10 Tooltips
		lineageTag: 3a2c800b-260a-5a7d-9498-2cc2d86ca277

	/// Average payment card tooltip: the same weeks a year before.
	measure 'Tooltip average payment year before' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR year_before_value = [Average payment year before SAR]
			VAR number_format = "#,0.0"
			VAR weeks_note = IF (
			        FORMAT ( [Average payment same weeks SAR], number_format ) <> FORMAT ( [Average payment SAR], number_format ),
			        " (" & COUNTROWS (
			            INTERSECT (
			                VALUES ( dim_date[week_of_year] ),
			                CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			            )
			        ) & " weeks of " & ( this_year - 1 ) & ")"
			    )
			RETURN
			    IF ( ISBLANK ( year_before_value ), UNICHAR ( 8211 ), FORMAT ( year_before_value, number_format ) & weeks_note )
		displayFolder: 10 Tooltips
		lineageTag: e58f2c2f-0989-5128-bab7-a0cd10e50bb7

	/// Average payment card tooltip: the change.
	measure 'Tooltip average payment change' =
			VAR shown = [Average payment change %]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( ROUND ( shown, 3 ), "+0.0%;" & UNICHAR ( 8722 ) & "0.0%;0.0%" ) )
		displayFolder: 10 Tooltips
		lineageTag: 753cd12a-d119-5a24-96aa-c06b4aef1eb6

	/// Biggest week card tooltip: the biggest week, billion SAR.
	measure 'Tooltip biggest week' =
			VAR shown = [Biggest week bn]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( shown, "#,0.00" ) )
		displayFolder: 10 Tooltips
		lineageTag: 083ae87f-4ccd-5189-b953-ab50ed0a8a12

	/// Biggest week card tooltip: which week it was, from Sunday to Saturday, and what kind of week.
	measure 'Tooltip biggest week date' =
			VAR biggest = [Biggest week bn]
			VAR biggest_week = MAXX ( FILTER ( VALUES ( dim_date[week_start] ), [Spent bn SAR] = biggest ), dim_date[week_start] )
			VAR phase = CALCULATE ( SELECTEDVALUE ( dim_date[phase] ), dim_date[week_start] = biggest_week )
			VAR last_day = biggest_week + 6
			VAR first_format =
			    IF ( MONTH ( biggest_week ) = MONTH ( last_day ), "d", IF ( YEAR ( biggest_week ) = YEAR ( last_day ), "d mmm", "d mmm yyyy" ) )
			RETURN
			    -- with no biggest week (a city and a sector both picked) every blank week equals the blank maximum: a dash then
			    IF (
			        ISBLANK ( biggest ) || ISBLANK ( biggest_week ),
			        UNICHAR ( 8211 ),
			        FORMAT ( biggest_week, first_format ) & " to " & FORMAT ( last_day, "d mmm yyyy" ) & IF ( NOT ISBLANK ( phase ), ", " & phase )
			    )
		displayFolder: 10 Tooltips
		lineageTag: 898b0c52-8260-5530-9af0-1b3cc9d1d048

	/// Biggest week card tooltip: the biggest of the same weeks a year before.
	measure 'Tooltip biggest week year before' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR year_before_value = [Biggest week year before bn]
			VAR number_format = "#,0.00"
			VAR weeks_note = ""
			RETURN
			    IF ( ISBLANK ( year_before_value ), UNICHAR ( 8211 ), FORMAT ( year_before_value, number_format ) & weeks_note )
		displayFolder: 10 Tooltips
		lineageTag: 01baa868-0709-5d40-b93b-5d600e008e0f

	/// Biggest week card tooltip: the change.
	measure 'Tooltip biggest week change' =
			VAR shown = [Biggest week change %]
			RETURN
			    IF ( ISBLANK ( shown ), UNICHAR ( 8211 ), FORMAT ( ROUND ( shown, 3 ), "+0.0%;" & UNICHAR ( 8722 ) & "0.0%;0.0%" ) )
		displayFolder: 10 Tooltips
		lineageTag: 3aead32d-6e57-5064-9946-8ef5a7f15b77

	/// Card tooltip: what the little line shows (the dot on the last week).
	measure 'Tooltip weekly line' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    IF (
			        ISBLANK ( [Spent bn SAR] ),
			        UNICHAR ( 8211 ),
			        "Each week of " & this_year & ", with a dot on the last one; dotted: the same weeks of " & ( this_year - 1 )
			    )
		displayFolder: 10 Tooltips
		lineageTag: 5c9b856a-5ec1-5542-8ed0-5bdf59baa29a

	/// Biggest week card tooltip: what the little line shows (the dot on the biggest week).
	measure 'Tooltip weekly line biggest' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    IF (
			        ISBLANK ( [Spent bn SAR] ),
			        UNICHAR ( 8211 ),
			        "Each week of " & this_year & ", with a dot on the biggest one; dotted: the same weeks of " & ( this_year - 1 )
			    )
		displayFolder: 10 Tooltips
		lineageTag: 0d2f813b-ab53-56fd-8a8c-cecf0eadf1e5

	/// Growth year by year tooltip: how many weeks the year is compared on, and which ('27 weeks, 5 Jan to 12 Jul 2025'; 2023's week 53 has no week 53 in 2022 to meet).
	measure 'Tooltip weeks compared' =
			VAR this_year = SELECTEDVALUE ( dim_date[year] )
			VAR shared_weeks =
			    INTERSECT (
			        VALUES ( dim_date[week_of_year] ),
			        CALCULATETABLE ( VALUES ( dim_date[week_of_year] ), REMOVEFILTERS ( dim_date ), dim_date[year] = this_year - 1 )
			    )
			VAR first_day = CALCULATE ( MIN ( dim_date[week_start] ), KEEPFILTERS ( shared_weeks ) )
			VAR last_day = CALCULATE ( MAX ( dim_date[week_start] ), KEEPFILTERS ( shared_weeks ) ) + 6
			RETURN
			    IF (
			        NOT ISBLANK ( [Spent same weeks bn] ),
			        COUNTROWS ( shared_weeks ) & " weeks, "
			            & FORMAT ( first_day, IF ( YEAR ( first_day ) = YEAR ( last_day ), "d mmm", "d mmm yyyy" ) )
			            & " to " & FORMAT ( last_day, "d mmm yyyy" )
			    )
		displayFolder: 10 Tooltips
		lineageTag: b59f1f77-7264-5d1f-aa68-4b9e690742ac

	/// Ramadan slope chart tooltip: this point against the 8 weeks before Ramadan in the same year. The chart groups by the phase and its sort column, so both lose their filter.
	measure 'Tooltip against weeks before' =
			VAR phase = SELECTEDVALUE ( dim_date[ramadan_phase] )
			VAR this_average = [Average week bn SAR]
			VAR base =
			    CALCULATE (
			        [Average week bn SAR],
			        REMOVEFILTERS ( dim_date[ramadan_phase], dim_date[ramadan_phase_order] ),
			        dim_date[ramadan_phase] = "8 weeks before"
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( this_average ), BLANK (),
			        phase = "8 weeks before", "None: these weeks are the base",
			        FORMAT ( ROUND ( DIVIDE ( this_average, base ) - 1, 3 ), "+0.0%;" & UNICHAR ( 8722 ) & "0.0%;0.0%" )
			    )
		displayFolder: 10 Tooltips
		lineageTag: 2c2c779f-4149-58a2-a306-29a51f28dd0a

	partition Measures_ = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table
