			VAR spark_first = MINX ( spark_weeks, dim_date[week_start] )
			VAR spark_days = DATEDIFF ( spark_first, MAXX ( spark_weeks, dim_date[week_start] ), DAY )
			VAR spark_points = CONCATENATEX ( spark_weeks, FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@v] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_points_before =
			    CONCATENATEX ( FILTER ( spark_weeks, NOT ISBLANK ( [@b] ) ), FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, dim_date[week_start], DAY ), spark_days ) * 82, "0.0" ) & "," & FORMAT ( 27 - DIVIDE ( [@b] - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ), " ", dim_date[week_start], ASC )
			VAR spark_dot_day = MAXX ( TOPN ( 1, spark_weeks, [@v], DESC ), dim_date[week_start] )
			VAR spark_dot_value = MAXX ( FILTER ( spark_weeks, dim_date[week_start] = spark_dot_day ), [@v] )
			VAR spark =
			    IF (
			        COUNTROWS ( spark_weeks ) >= 2,
			        "<svg width='88' height='30' viewBox='0 0 88 30' style='flex:none'>"
			            & IF (
			                spark_points_before <> "",
			                "<polyline points='" & spark_points_before & "' fill='none' stroke='#AEB7C2' stroke-width='1.2' stroke-dasharray='2 2'/>"
			            )
			            & "<polyline points='" & spark_points & "' fill='none' stroke='#4F5966' stroke-width='1.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & FORMAT ( 3 + DIVIDE ( DATEDIFF ( spark_first, spark_dot_day, DAY ), spark_days ) * 82, "0.0" ) & "' cy='"
			            & FORMAT ( 27 - DIVIDE ( spark_dot_value - spark_lo, spark_hi - spark_lo ) * 24, "0.0" ) & "' r='2.5' fill='#344054'/></svg>"
			    )
			VAR shown_value = IF ( ISBLANK ( card_value ), UNICHAR ( 8211 ), FORMAT ( card_value, number_format ) )
			VAR comparison =
			    IF (
			        NOT ISBLANK ( change_value ),
			        SWITCH (
			        TRUE (),
			        ISBLANK ( change_value ), "",
			        ROUND ( change_value, 3 ) > 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#15803D;background:#DCFCE7'>" & UNICHAR ( 9650 ) & " " & "+" & FORMAT ( change_value, "0.0%" ) & "</span>",
			        ROUND ( change_value, 3 ) < 0, "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#C81E1E;background:#FEE2E2'>" & UNICHAR ( 9660 ) & " " & UNICHAR ( 8722 ) & FORMAT ( ABS ( change_value ), "0.0%" ) & "</span>",
			        "<span style='display:inline-block;padding:0 6px;border-radius:9px;font-weight:600;color:#4F5966;background:#EDF0F3'>" & "0.0%" & "</span>"
			    )
			            & "<span style='margin-left:6px'>vs " & FORMAT ( before_value, number_format )
			            & " in " & ( this_year - 1 ) & "</span>"
			    )
			VAR note_text = [Note biggest week]
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#13161B;height:88px;overflow:hidden'>"
			        & "<div style='font-size:12px;line-height:16px;color:#4F5966'>Biggest week (bn SAR)</div>"
			        & "<div style='display:flex;justify-content:space-between;align-items:center;height:32px;margin-top:2px'>"
			        & "<div style='font-size:26px;line-height:32px;font-weight:600'>" & shown_value & "</div>" & spark & "</div>"
			        & "<div style='font-size:11px;line-height:18px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & comparison & "</div>"
			        & "<div style='font-size:11px;line-height:14px;margin-top:2px;color:#646E7B;white-space:nowrap'>" & note_text & "</div>"
			        & "</div>"
		displayFolder: 9 HTML
		lineageTag: ca8b6520-8922-5bcf-99a5-59bea5fe36dd

	/// One row of the Sectors table; the largest sector's row also holds the header and the smallest one's the 'All sectors' total.
	measure 'HTML sector row' =
			VAR sector_spent = [Spent bn SAR]
			VAR sector_growth = [Spending growth %]
			VAR sector_payments = [Payments growth %]
			VAR sector_average = [Average payment SAR]
			VAR sector_change = [Average payment change %]
			VAR in_view = ALLSELECTED ( dim_sector[sector] )
			VAR largest = MAXX ( in_view, [Spent bn SAR] )
			VAR smallest = MINX ( in_view, [Spent bn SAR] )
			VAR total_0 = CALCULATE ( [Spent bn SAR], REMOVEFILTERS ( dim_sector ) )
			VAR total_1 = CALCULATE ( [Spending growth %], REMOVEFILTERS ( dim_sector ) )
			VAR total_2 = CALCULATE ( [Payments growth %], REMOVEFILTERS ( dim_sector ) )
			VAR total_3 = CALCULATE ( [Average payment SAR], REMOVEFILTERS ( dim_sector ) )
			VAR total_4 = CALCULATE ( [Average payment change %], REMOVEFILTERS ( dim_sector ) )
			VAR header_row = "<div style='font-size:14.67px;line-height:20px;font-weight:600;color:#13161B'>Every sector</div><div style='font-size:12px;line-height:16px;color:#4F5966;margin:2px 0 14px'>Largest first. Changes on the same weeks a year before: <span style='color:#15803D'>&#9650;</span> up, <span style='color:#C81E1E'>&#9660;</span> down.</div><div style='display:flex;align-items:flex-end;height:24px;padding-bottom:4px;border-bottom:1px solid #13161B;font-size:12px;font-weight:600;color:#13161B;line-height:16px'><div style='width:150px;text-align:left;white-space:nowrap'>Sector</div><div style='width:104px;text-align:center;white-space:nowrap'>Spent (bn SAR)</div><div style='width:116px;text-align:center;white-space:nowrap'>Spending growth</div><div style='width:116px;text-align:center;white-space:nowrap'>Payments growth</div><div style='width:124px;text-align:center;white-space:nowrap'>Avg. payment (SAR)</div><div style='width:100px;text-align:center;white-space:nowrap'>Change</div></div>"
			VAR sector_line =
			    "<div style='display:flex;align-items:center;height:24px;border-bottom:1px solid #EDF0F3;font-size:13px;font-weight:400;color:#13161B'>"
			            & "<div style='width:150px;text-align:left'>" & SELECTEDVALUE ( dim_sector[sector] ) & "</div>"
			            & "<div style='width:104px;text-align:center'>" & FORMAT ( sector_spent, "#,0.00" ) & "</div>"
			            & "<div style='width:116px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( sector_growth ), "",
			        ROUND ( sector_growth, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( sector_growth, "0.0%" ) & "</span></span>",
			        ROUND ( sector_growth, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_growth ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:116px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( sector_payments ), "",
			        ROUND ( sector_payments, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( sector_payments, "0.0%" ) & "</span></span>",
			        ROUND ( sector_payments, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_payments ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:124px;text-align:center'>" & FORMAT ( sector_average, "#,0.0" ) & "</div>"
			            & "<div style='width:100px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( sector_change ), "",
			        ROUND ( sector_change, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( sector_change, "0.0%" ) & "</span></span>",
			        ROUND ( sector_change, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( sector_change ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "</div>"
			VAR total_line =
			    "<div style='display:flex;align-items:center;height:24px;border-top:1px solid #13161B;margin-top:-1px;font-size:13px;font-weight:600;color:#13161B'>"
			            & "<div style='width:150px;text-align:left'>" & "All sectors" & "</div>"
			            & "<div style='width:104px;text-align:center'>" & FORMAT ( total_0, "#,0.00" ) & "</div>"
			            & "<div style='width:116px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( total_1 ), "",
			        ROUND ( total_1, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( total_1, "0.0%" ) & "</span></span>",
			        ROUND ( total_1, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_1 ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:116px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( total_2 ), "",
			        ROUND ( total_2, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( total_2, "0.0%" ) & "</span></span>",
			        ROUND ( total_2, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_2 ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "<div style='width:124px;text-align:center'>" & FORMAT ( total_3, "#,0.0" ) & "</div>"
			            & "<div style='width:100px;text-align:center'>" & SWITCH (
			        TRUE (),
			        ISBLANK ( total_4 ), "",
			        ROUND ( total_4, 3 ) > 0, "<span style='display:inline-flex;color:#15803D'><span style='width:14px;text-align:center'>" & UNICHAR ( 9650 ) & "</span><span style='width:50px;text-align:right'>" & "+" & FORMAT ( total_4, "0.0%" ) & "</span></span>",
			        ROUND ( total_4, 3 ) < 0, "<span style='display:inline-flex;color:#C81E1E'><span style='width:14px;text-align:center'>" & UNICHAR ( 9660 ) & "</span><span style='width:50px;text-align:right'>" & UNICHAR ( 8722 ) & FORMAT ( ABS ( total_4 ), "0.0%" ) & "</span></span>",
			        "<span style='display:inline-flex;color:#4F5966'><span style='width:14px;text-align:center'>" & "" & "</span><span style='width:50px;text-align:right'>" & "0.0%" & "</span></span>"
			    ) & "</div>"
			            & "</div>"
			RETURN
			    IF (
			        HASONEVALUE ( dim_sector[sector] ) && NOT ISBLANK ( sector_spent ),
			        "<div style='font-family:Segoe UI,sans-serif;font-variant-numeric:tabular-nums'>"
			            & IF ( sector_spent = largest, header_row ) & sector_line & IF ( sector_spent = smallest, total_line )
			            & "</div>"
			    )
		displayFolder: 9 HTML
		lineageTag: 013ccb5a-71c2-5d06-ba52-823dcc2a3220

	partition Measures_ = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table
